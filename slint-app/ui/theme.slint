// Theme definitions for SAP Login Manager - Slint Edition
// Supports light/dark themes via global singleton with dynamic switching

export global Theme {
    // Dark mode flag - set from Rust backend / settings
    in-out property <bool> dark: false;

    // ===== Dynamic theme colors (switch on `dark`) =====
    out property <color> bg-primary: dark ? #1c1c1e : #ffffff;
    out property <color> bg-secondary: dark ? #2c2c2e : #f5f5f7;
    out property <color> bg-hover: dark ? #3a3a3c : #e8e8ed;
    out property <color> bg-card: dark ? #2c2c2e : #ffffff;
    out property <color> bg-input: dark ? #3a3a3c : #f5f5f7;
    out property <color> text-primary: dark ? #f5f5f7 : #1d1d1f;
    out property <color> text-secondary: dark ? #98989d : #86868b;
    out property <color> text-muted: dark ? #636366 : #aeaeb2;
    out property <color> border: dark ? #38383a : #d2d2d7;
    out property <color> accent: dark ? #0a84ff : #0071e3;
    out property <color> accent-hover: dark ? #409cff : #0077ed;
    out property <color> accent-light: dark ? #0a84ff20 : #0071e320;
    out property <color> danger: dark ? #ff453a : #ff3b30;
    out property <color> success: dark ? #32d74b : #34c759;
    out property <color> warning: dark ? #ff9f0a : #ff9500;
    out property <color> shadow: dark ? #00000040 : #00000010;
    out property <color> overlay: dark ? #00000099 : #00000055;

    // Gradient colors
    out property <color> gradient-start: dark ? #0a84ff : #0071e3;
    out property <color> gradient-end: dark ? #409cff : #0091ff;

    // Environment colors
    out property <color> env-production: dark ? #ff453a : #ff3b30;
    out property <color> env-test: dark ? #ff9f0a : #ff9500;
    out property <color> env-development: dark ? #32d74b : #34c759;
    out property <color> env-configuration: dark ? #5e5ce6 : #5856d6;

    // Sizes
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 24px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 20px;

    // Helper: environment color
    public pure function env-color(env: string) -> color {
        if env == "production" { env-production }
        else if env == "test" { env-test }
        else if env == "development" { env-development }
        else if env == "configuration" { env-configuration }
        else { text-muted }
    }
}
