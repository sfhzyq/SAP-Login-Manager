import { Theme } from "theme.slint";
import { Switch, CheckBox, LineEdit, SpinBox } from "std-widgets.slint";
export { Theme }

// ===== Data Models =====

export struct CredentialItem {
    id: string,
    connection-id: string,
    display-name: string,
    client: string,
    username: string,
    language: string,
    system-id: string,
    environment: string,
    color-tag: string,
    is-favorite: bool,
    login-count: int,
    group-id: string,
    snc-enabled: bool,
    description: string,
    is-selected: bool,
}

export struct GroupItem {
    id: string,
    name: string,
    count: int,
    is-system: bool,
    is-default: bool,
}

// ===== Reusable input component =====
// ===== Toggle Switch =====
// ===== Unlock/Setup Page =====
component UnlockPage inherits Rectangle {
    in property <bool> is-setup;
    in property <string> prompt;
    in property <string> button-text;
    in property <string> hint;
    in property <string> error-message;
    callback submitted(string);

    background: Theme.bg-primary;

    VerticalLayout {
        alignment: center;
        spacing: Theme.spacing-lg;
        padding-left: 40px;
        padding-right: 40px;
        padding-top: 40px;
        padding-bottom: 40px;

        Text {
            text: "SAP";
            font-size: 48px;
            font-weight: 800;
            color: Theme.accent;
            horizontal-alignment: center;
        }

        Text {
            text: "Login Manager";
            font-size: Theme.font-xl;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }

        Text {
            text: root.prompt;
            font-size: Theme.font-md;
            color: Theme.text-primary;
            horizontal-alignment: center;
        }

        pw-field := LineEdit {
            input-type: InputType.password;
            placeholder-text: "请输入主密码";
            accepted => { root.submitted(self.text); }
        }

        unlock-btn := Rectangle {
            background: unlock-touch.pressed ? Theme.accent-hover : (unlock-touch.has-hover ? Theme.accent-hover : Theme.accent);
            border-radius: Theme.radius-md;
            height: 44px;
            horizontal-stretch: 1;
            drop-shadow-blur: unlock-touch.has-hover ? 12px : 0px;
            drop-shadow-color: Theme.accent;
            drop-shadow-offset-y: 3px;
            animate background, drop-shadow-blur { duration: 150ms; }
            Text {
                text: root.button-text;
                color: white;
                font-size: Theme.font-md;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            unlock-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => {
                    root.submitted(pw-field.text);
                }
            }
        }

        if root.error-message != "" : Text {
            text: root.error-message;
            color: Theme.danger;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
        }
    }
}

// ===== Settings Page =====
component SettingsPage inherits Rectangle {
    in-out property <bool> password-free;
    in-out property <int> batch-interval;
    in-out property <int> auto-lock;
    in-out property <int> clipboard-clear;
    in-out property <bool> group-by-env;
    in-out property <bool> compact;
    in-out property <string> language;
    in-out property <string> theme;
    in-out property <string> sap-logon-path;

    in property <string> t-save;
    in property <string> t-cancel;
    in property <string> t-password-free;
    in property <string> t-password-free-hint;
    in property <string> t-batch-interval;
    in property <string> t-auto-lock;
    in property <string> t-clipboard-clear;
    in property <string> t-group-by-env;
    in property <string> t-compact-mode;
    in property <string> t-language;
    in property <string> t-theme-light;
    in property <string> t-theme-dark;
    in property <string> t-sap-logon;

    callback save(bool, int, int, int, bool, bool, string, string, string);
    callback cancel();

    background: Theme.bg-secondary;

    VerticalLayout {
        spacing: 1px;

        // Header bar
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-top: 8px;
                padding-bottom: 8px;

                Text {
                    text: root.t-cancel;
                    font-size: Theme.font-md;
                    color: Theme.accent;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.cancel(); } }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    background: Theme.accent;
                    border-radius: Theme.radius-sm;
                    width: 60px;
                    TouchArea {
                        clicked => {
                            root.save(root.password-free, root.batch-interval,
                                      root.auto-lock, root.clipboard-clear,
                                      root.group-by-env, root.compact,
                                      root.language, root.theme, root.sap-logon-path);
                        }
                    }
                    Text {
                        text: root.t-save;
                        color: white;
                        font-size: Theme.font-sm;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Password-free toggle
        Rectangle {
            background: Theme.bg-primary;
            height: 56px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                spacing: Theme.spacing-sm;
                VerticalLayout {
                    Text {
                        text: root.t-password-free;
                        font-size: Theme.font-md;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: root.t-password-free-hint;
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Switch {
                    checked: root.password-free;
                    toggled => { root.password-free = self.checked; }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Batch interval
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-batch-interval;
                    font-size: Theme.font-md;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                SpinBox {
                    value: root.batch-interval;
                    minimum: 0;
                    maximum: 60;
                    edited(v) => { root.batch-interval = v; }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Auto lock
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-auto-lock;
                    font-size: Theme.font-md;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                SpinBox {
                    value: root.auto-lock;
                    minimum: 0;
                    maximum: 60;
                    edited(v) => { root.auto-lock = v; }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Clipboard clear
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-clipboard-clear;
                    font-size: Theme.font-md;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                SpinBox {
                    value: root.clipboard-clear;
                    minimum: 0;
                    maximum: 120;
                    edited(v) => { root.clipboard-clear = v; }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Group by env
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-group-by-env;
                    font-size: Theme.font-md;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Switch {
                    checked: root.group-by-env;
                    toggled => { root.group-by-env = self.checked; }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Compact mode
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-compact-mode;
                    font-size: Theme.font-md;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Switch {
                    checked: root.compact;
                    toggled => { root.compact = self.checked; }
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Language
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-language;
                    font-size: Theme.font-md;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.language == "ZH" ? "中文" : root.language == "EN" ? "English" : "日本語";
                    font-size: Theme.font-md;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { background: Theme.border; height: 1px; }

        // Theme
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding: Theme.spacing-md;
                Text {
                    text: root.t-theme-light;
                    font-size: Theme.font-md;
                    color: root.theme == "light" ? Theme.accent : Theme.text-secondary;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.theme = "light"; } }
                }
                Rectangle { width: 8px; }
                Text {
                    text: "/";
                    font-size: Theme.font-md;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle { width: 8px; }
                Text {
                    text: root.t-theme-dark;
                    font-size: Theme.font-md;
                    color: root.theme == "dark" ? Theme.accent : Theme.text-secondary;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.theme = "dark"; } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

// ===== Main Page =====
component MainPage inherits Rectangle {
    in property <[CredentialItem]> credentials;
    in property <[GroupItem]> groups;
    in property <string> search-text;
    in property <string> active-group;
    in property <int> all-count;
    in property <int> favorites-count;
    in property <bool> batch-mode;
    in property <[CredentialItem]> selected-creds;
    in-out property <bool> show-credential-form;
    in-out property <bool> show-reveal-modal;
    in-out property <bool> show-delete-confirm;
    in-out property <CredentialItem> editing-cred;
    in property <string> reveal-cred-id;
    in property <string> reveal-cred-name;
    in property <string> revealed-password;
    in property <bool> reveal-verified;
    in-out property <string> delete-cred-name;
    in property <bool> show-more-menu;
    in property <bool> show-toast;
    in property <string> toast-message;

    // i18n strings
    in property <string> t-title;
    in property <string> t-search-placeholder;
    in property <string> t-add;
    in property <string> t-login;
    in property <string> t-batch-login;
    in property <string> t-copy-password;
    in property <string> t-reveal-password;
    in property <string> t-edit;
    in property <string> t-delete;
    in property <string> t-favorite;
    in property <string> t-cancel-favorite;
    in property <string> t-share;
    in property <string> t-settings;
    in property <string> t-save;
    in property <string> t-cancel;
    in property <string> t-confirm-delete;
    in property <string> t-delete-warning;
    in property <string> t-group-all;
    in property <string> t-group-favorites;
    in property <string> t-lock;
    in property <string> t-sap-logon;
    in property <string> t-import;
    in property <string> t-export;
    in property <string> t-reveal-title;
    in property <string> t-reveal-verify;
    in property <string> t-reveal-verify-btn;
    in property <string> t-reveal-password-label;
    in property <string> t-reveal-copy;
    in property <string> t-reveal-auto-hide;
    in property <string> t-connection-name;
    in property <string> t-client;
    in property <string> t-username;
    in property <string> t-password;
    in property <string> t-language-field;
    in property <string> t-system-id;
    in property <string> t-environment;
    in property <string> t-description;
    in property <string> t-snc;
    in property <string> t-snc-sso;
    in property <string> t-empty-list;
    in property <string> t-no-creds-selected;
    in property <string> t-group-manage;
    in property <string> t-group-create;
    in property <string> t-group-rename;
    in property <string> t-group-delete;
    in property <string> t-group-delete-warn;
    in property <string> t-group-delete-move;
    in property <string> t-group-delete-all;
    in property <string> t-group-section-system;
    in property <string> t-group-section-custom;
    in property <string> t-group-name-prompt;
    in property <string> t-group-empty;
    in property <string> t-batch-move;
    in property <string> t-batch-select;
    in property <string> t-batch-cancel;
    in property <string> t-batch-selected;

    // Filtered credentials
    in property <[CredentialItem]> filtered-credentials;

    // Group management state (passed through from App root)
    in-out property <bool> show-group-dropdown;
    in-out property <bool> show-create-group;
    in-out property <bool> show-rename-group;
    in-out property <bool> show-delete-group;
    in-out property <string> rename-group-id;
    in-out property <string> rename-group-name;
    in-out property <string> delete-group-id;
    in-out property <string> delete-group-name;
    in-out property <string> delete-group-mode;
    in-out property <int> delete-group-count;
    in property <string> current-group-name;
    in property <int> current-group-count;
    in-out property <bool> show-batch-move-dropdown;

    // Callbacks
    callback search-changed(string);
    callback group-changed(string);
    callback login(string);
    callback batch-login();
    callback copy-password(string);
    callback reveal-password(string);
    callback edit(string);
    callback save-cred();
    callback delete(string);
    callback toggle-favorite(string);
    callback share(string);
    callback open-sap-logon();
    callback import-connections();
    callback export-creds();
    callback lock();
    callback select(string, bool);
    callback batch-move(string);
    callback batch-fav(bool);
    callback show-settings();
    callback add-new();
    callback verify-reveal(string);
    callback close-reveal();
    callback close-form();
    callback close-delete();
    callback confirm-delete();
    callback cancel-batch();
    callback toggle-more-menu();
    callback enter-batch();
    callback sap-logon();
    callback import-conn();
    callback export-conn();
    callback create-group(string);
    callback rename-group(string, string);
    callback delete-group(string, string);
    callback toggle-group-dropdown();
    callback close-group-dropdown();
    callback close-create-group();
    callback close-rename-group();
    callback close-delete-group();
    callback start-rename-group(string, string);
    callback start-delete-group(string, string, int);

    background: Theme.bg-secondary;

    VerticalLayout {
        // Top bar
        Rectangle {
            background: Theme.bg-primary;
            height: 48px;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: Theme.spacing-sm;

                Text {
                    text: root.t-title;
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }

                // Lock
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: lock-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                    lock-touch := TouchArea { clicked => { root.lock(); } }
                    Text {
                        text: "🔒";
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // More menu (⋮)
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: more-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                    more-touch := TouchArea { clicked => { root.toggle-more-menu(); } }
                    Text {
                        text: "⋮";
                        font-size: 18px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Settings
                Rectangle {
                    width: 32px; height: 32px;
                    border-radius: 16px;
                    background: settings-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                    settings-touch := TouchArea { clicked => { root.show-settings(); } }
                    Text {
                        text: "⚙";
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Search bar
        Rectangle {
            background: Theme.bg-primary;
            height: 44px;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-top: Theme.spacing-sm;
                padding-bottom: Theme.spacing-sm;

                search-field := LineEdit {
                    placeholder-text: root.t-search-placeholder;
                    horizontal-stretch: 1;
                    edited => { root.search-changed(self.text); }
                }
            }
        }

        // Group selector (dropdown trigger)
        Rectangle {
            background: Theme.bg-primary;
            height: 40px;
            HorizontalLayout {
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-top: 6px;
                padding-bottom: 6px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-sm;
                    background: grp-trigger.pressed ? Theme.bg-hover : Theme.bg-input;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding-left: Theme.spacing-sm;
                        padding-right: Theme.spacing-sm;
                        spacing: 6px;

                        Text {
                            text: "📁";
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.current-group-name;
                            font-size: Theme.font-md;
                            font-weight: 600;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.current-group-count;
                            font-size: Theme.font-sm;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "▾";
                            font-size: 11px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }

                    // TouchArea as overlay (fills parent Rectangle)
                    grp-trigger := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-group-dropdown(); }
                    }
                }
            }
        }

        // Credential list (scrollable)
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.spacing-sm;
                padding-top: Theme.spacing-sm;
                padding-left: Theme.spacing-md;
                padding-right: Theme.spacing-md;
                padding-bottom: 80px;

                for cred in root.filtered-credentials : Rectangle {
                    height: 72px;
                    background: root.batch-mode && cred.is-selected ? Theme.accent-light : (card-touch.pressed ? Theme.bg-hover : (card-touch.has-hover ? Theme.bg-hover : Theme.bg-card));
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: root.batch-mode && cred.is-selected ? Theme.accent : Theme.border;
                    drop-shadow-blur: card-touch.has-hover ? 12px : 4px;
                    drop-shadow-color: Theme.shadow;
                    drop-shadow-offset-y: card-touch.has-hover ? 4px : 2px;
                    animate background, drop-shadow-blur, drop-shadow-offset-y { duration: 150ms; }
                    card-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.batch-mode {
                                root.select(cred.id, !cred.is-selected);
                            } else {
                                root.edit(cred.id);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;

                        // Checkbox (visible in batch mode)
                        if root.batch-mode : CheckBox {
                            checked: cred.is-selected;
                            toggled => { root.select(cred.id, !cred.is-selected); }
                        }

                        Rectangle {
                            width: 4px;
                            border-radius: 2px;
                            background: Theme.env-color(cred.environment);
                        }

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            HorizontalLayout {
                                spacing: Theme.spacing-xs;
                                Text {
                                    text: cred.display-name != "" ? cred.display-name : cred.connection-id;
                                    font-size: Theme.font-md;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if cred.is-favorite : Text {
                                    text: "★";
                                    font-size: 12px;
                                    color: Theme.warning;
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.spacing-sm;
                                Text {
                                    text: cred.system-id;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                }
                                if cred.username != "" : Text {
                                    text: "| " + cred.username;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-muted;
                                }
                            }

                            if cred.client != "" : Text {
                                text: "Client: " + cred.client;
                                font-size: Theme.font-sm;
                                color: Theme.text-muted;
                            }
                        }

                        // Favorite toggle
                        Rectangle {
                            width: 28px;
                            fav-touch := TouchArea { clicked => { root.toggle-favorite(cred.id); } }
                            Text {
                                text: cred.is-favorite ? "★" : "☆";
                                font-size: 14px;
                                color: cred.is-favorite ? Theme.warning : Theme.text-muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 56px;
                            border-radius: Theme.radius-sm;
                            background: login-touch.pressed ? Theme.accent-hover : Theme.accent;
                            animate background { duration: 120ms; }
                            login-touch := TouchArea { mouse-cursor: pointer; clicked => { root.login(cred.id); } }
                            Text {
                                text: root.t-login;
                                color: white;
                                font-size: Theme.font-sm;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.filtered-credentials.length == 0 : Rectangle {
                    height: 240px;
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.spacing-md;
                        Text {
                            text: "📭";
                            font-size: 48px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.t-empty-list;
                            color: Theme.text-muted;
                            font-size: Theme.font-md;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // More menu dropdown (outside layout for absolute positioning)
    if root.show-more-menu : Rectangle {
        x: parent.width - self.width - 16px;
        y: 48px;
        width: 160px;
        border-radius: Theme.radius-md;
        background: Theme.bg-primary;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 6px;
        VerticalLayout {
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Text { text: root.t-sap-logon; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                TouchArea { clicked => { root.sap-logon(); } }
            }
            Rectangle { background: Theme.border; height: 1px; }
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Text { text: root.t-import; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                TouchArea { clicked => { root.import-conn(); } }
            }
            Rectangle { background: Theme.border; height: 1px; }
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Text { text: root.t-export; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                TouchArea { clicked => { root.export-conn(); } }
            }
            Rectangle { background: Theme.border; height: 1px; }
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Text { text: root.t-batch-login; font-size: Theme.font-md; color: Theme.accent; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                TouchArea { clicked => { root.batch-login(); } }
            }
            Rectangle { background: Theme.border; height: 1px; }
            Rectangle {
                height: 40px;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    Text { text: root.t-batch-select; font-size: Theme.font-md; color: Theme.accent; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                TouchArea { clicked => { root.enter-batch(); } }
            }
        }
    }

    // Group dropdown panel (overlay)
    if root.show-group-dropdown : Rectangle {
        background: #00000000;
        TouchArea { clicked => { root.close-group-dropdown(); } }

        Rectangle {
            x: 16px;
            y: 132px;
            width: parent.width - 32px;
            height: 320px;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 6px;
            clip: true;

            VerticalLayout {
                padding: Theme.spacing-sm;
                spacing: 0px;

                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.spacing-xs;
                        spacing: 0px;

                        // All
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: grp-all-touch.pressed ? Theme.bg-hover : (root.active-group == "all" ? Theme.bg-hover : #00000000);
                            grp-all-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.group-changed("all"); root.close-group-dropdown(); }
                            }
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                padding-right: Theme.spacing-md;
                                Text { text: root.t-group-all; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: root.all-count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }

                        // Favorites
                        Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: grp-fav-touch.pressed ? Theme.bg-hover : (root.active-group == "favorites" ? Theme.bg-hover : #00000000);
                            grp-fav-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.group-changed("favorites"); root.close-group-dropdown(); }
                            }
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                padding-right: Theme.spacing-md;
                                Text { text: "★ " + root.t-group-favorites; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: root.favorites-count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }

                        // Divider
                        Rectangle { background: Theme.border; height: 1px; }

                        // System groups section header
                        Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                Text { text: root.t-group-section-system; font-size: Theme.font-sm; color: Theme.text-muted; vertical-alignment: center; }
                            }
                        }

                        // System groups from model
                        for grp in root.groups : Rectangle {
                            height: grp.is-system ? 36px : 0px;
                            visible: grp.is-system;
                            border-radius: Theme.radius-sm;
                            background: sys-grp-touch.pressed ? Theme.bg-hover : (root.active-group == grp.id ? Theme.bg-hover : #00000000);
                            sys-grp-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.group-changed(grp.id); root.close-group-dropdown(); }
                            }
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                padding-right: Theme.spacing-md;
                                Text { text: grp.name; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: grp.count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }

                        // Default group (non-system, is-default) shown in system section
                        for grp in root.groups : Rectangle {
                            height: (grp.is-default && !grp.is-system) ? 36px : 0px;
                            visible: grp.is-default && !grp.is-system;
                            border-radius: Theme.radius-sm;
                            background: def-grp-touch.pressed ? Theme.bg-hover : (root.active-group == grp.id ? Theme.bg-hover : #00000000);
                            def-grp-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.group-changed(grp.id); root.close-group-dropdown(); }
                            }
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                padding-right: Theme.spacing-md;
                                Text { text: grp.name; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: grp.count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }

                        // Custom groups section header
                        Rectangle {
                            height: 28px;
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                Text { text: root.t-group-section-custom; font-size: Theme.font-sm; color: Theme.text-muted; vertical-alignment: center; }
                            }
                        }

                        // Custom groups from model
                        for grp in root.groups : Rectangle {
                            height: (!grp.is-system && !grp.is-default) ? 40px : 0px;
                            visible: !grp.is-system && !grp.is-default;
                            border-radius: Theme.radius-sm;
                            background: cust-grp-touch.pressed ? Theme.bg-hover : (root.active-group == grp.id ? Theme.bg-hover : #00000000);
                            cust-grp-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.group-changed(grp.id); root.close-group-dropdown(); }
                            }
                            HorizontalLayout {
                                padding-left: Theme.spacing-md;
                                padding-right: Theme.spacing-sm;
                                Text { text: grp.name; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: grp.count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                                // Rename button
                                Rectangle {
                                    width: 28px;
                                    rn-btn := TouchArea { mouse-cursor: pointer; clicked => { root.start-rename-group(grp.id, grp.name); root.close-group-dropdown(); } }
                                    Text { text: "✏"; font-size: 12px; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                // Delete button
                                Rectangle {
                                    width: 28px;
                                    del-btn := TouchArea { mouse-cursor: pointer; clicked => { root.start-delete-group(grp.id, grp.name, grp.count); root.close-group-dropdown(); } }
                                    Text { text: "×"; font-size: 16px; color: Theme.danger; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Divider
                Rectangle { background: Theme.border; height: 1px; }

                // New group button
                Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-sm;
                    background: new-grp-touch.pressed ? Theme.bg-hover : #00000000;
                    new-grp-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-group-dropdown(); root.show-create-group = true; }
                    }
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        Text { text: "+ " + root.t-group-create; font-size: Theme.font-md; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
            }
        }
    }

    // FAB
    if !root.batch-mode : Rectangle {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 16px;
        width: 48px; height: 48px;
        border-radius: 24px;
        background: fab-touch.pressed ? Theme.accent-hover : Theme.accent;
        drop-shadow-blur: fab-touch.has-hover ? 20px : 12px;
        drop-shadow-color: Theme.accent;
        drop-shadow-offset-y: 4px;
        animate drop-shadow-blur, background { duration: 150ms; }
        fab-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.add-new(); }
        }
        Text {
            text: "+";
            color: white;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Batch action bar (shown when batch mode is active)
    if root.batch-mode : Rectangle {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        height: 56px;
        background: Theme.bg-primary;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: -4px;

        HorizontalLayout {
            padding-left: Theme.spacing-md;
            padding-right: Theme.spacing-md;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: Theme.spacing-md;
            alignment: center;

            // Selected count
            Text {
                text: root.selected-creds.length + " " + root.t-batch-selected;
                font-size: Theme.font-md;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // Move to group button
            Rectangle {
                width: 120px;
                height: 40px;
                border-radius: Theme.radius-md;
                background: mv-grp-touch.pressed ? Theme.accent-hover : Theme.accent;
                mv-grp-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-batch-move-dropdown = !root.show-batch-move-dropdown; }
                }
                Text {
                    text: root.t-batch-move;
                    color: white;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Cancel button
            Rectangle {
                width: 72px;
                height: 40px;
                border-radius: Theme.radius-md;
                background: bat-cancel.pressed ? Theme.bg-hover : Theme.bg-secondary;
                bat-cancel := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.cancel-batch(); }
                }
                Text {
                    text: root.t-batch-cancel;
                    color: Theme.text-primary;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Batch move dropdown panel
    if root.batch-mode && root.show-batch-move-dropdown : Rectangle {
        background: #00000000;
        TouchArea { clicked => { root.show-batch-move-dropdown = false; } }

        Rectangle {
            x: 16px;
            y: parent.height - self.height - 72px;
            width: parent.width - 32px;
            height: 280px;
            border-radius: Theme.radius-md;
            background: Theme.bg-primary;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 20px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 6px;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                VerticalLayout {
                    padding: Theme.spacing-sm;
                    spacing: 0px;

                    // System groups
                    for grp in root.groups : Rectangle {
                        height: grp.is-system || grp.is-default ? 36px : 0px;
                        visible: grp.is-system || grp.is-default;
                        border-radius: Theme.radius-sm;
                        background: bm-grp-touch.pressed ? Theme.bg-hover : #00000000;
                        bm-grp-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.batch-move(grp.id); root.show-batch-move-dropdown = false; }
                        }
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            Text { text: grp.name; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: grp.count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }

                    // Divider
                    Rectangle { background: Theme.border; height: 1px; }

                    // Custom groups
                    for grp in root.groups : Rectangle {
                        height: (!grp.is-system && !grp.is-default) ? 36px : 0px;
                        visible: !grp.is-system && !grp.is-default;
                        border-radius: Theme.radius-sm;
                        background: bm-cust-touch.pressed ? Theme.bg-hover : #00000000;
                        bm-cust-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.batch-move(grp.id); root.show-batch-move-dropdown = false; }
                        }
                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            padding-right: Theme.spacing-md;
                            Text { text: grp.name; font-size: Theme.font-md; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                            Text { text: grp.count; font-size: Theme.font-sm; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    // Toast
    if root.show-toast : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 80px;
        min-width: 160px;
        width: toast-txt.preferred-width + 40px;
        height: 40px;
        border-radius: 20px;
        background: Theme.dark ? #f5f5f7e6 : #1d1d1fe6;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 4px;
        toast-txt := Text {
            text: root.toast-message;
            color: Theme.dark ? #1d1d1f : white;
            font-size: Theme.font-md;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ===== Credential Form Modal =====
    if root.show-credential-form : Rectangle {
        background: Theme.overlay;
        animate background { duration: 200ms; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - 32px;
            height: 520px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-primary;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                // Header
                Rectangle {
                    height: 44px;
                    background: Theme.bg-primary;
                    border-radius: Theme.radius-lg;
                    HorizontalLayout {
                        padding-left: Theme.spacing-lg;
                        padding-right: Theme.spacing-lg;
                        Text {
                            text: root.editing-cred.id == "" ? root.t-add : root.t-edit;
                            font-size: Theme.font-lg;
                            font-weight: 700;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 28px; height: 28px;
                            border-radius: 14px;
                            background: close-form-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                            close-form-touch := TouchArea { clicked => { root.close-form(); } }
                            Text {
                                text: "✕";
                                font-size: 14px;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { background: Theme.border; height: 1px; }

                // Form body (scrollable)
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.spacing-lg;
                        spacing: Theme.spacing-md;

                        // Connection name + System ID (3:7)
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.t-system-id;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                }
                                LineEdit {
                                    text: root.editing-cred.system-id;
                                    placeholder-text: "PRD";
                                    font-size: Theme.font-md;
                                    edited => { root.editing-cred.system-id = self.text; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: root.t-connection-name;
                                    font-size: Theme.font-sm;
                                    color: Theme.text-secondary;
                                }
                                LineEdit {
                                    text: root.editing-cred.connection-id;
                                    placeholder-text: root.t-connection-name;
                                    font-size: Theme.font-md;
                                    edited => { root.editing-cred.connection-id = self.text; }
                                }
                            }
                        }

                        // Client + Username
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.t-client; font-size: Theme.font-sm; color: Theme.text-secondary; }
                                LineEdit {
                                    text: root.editing-cred.client;
                                    font-size: Theme.font-md;
                                    edited => { root.editing-cred.client = self.text; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 2px;
                                Text { text: root.t-username; font-size: Theme.font-sm; color: Theme.text-secondary; }
                                LineEdit {
                                    text: root.editing-cred.username;
                                    font-size: Theme.font-md;
                                    edited => { root.editing-cred.username = self.text; }
                                }
                            }
                        }

                        // Password
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: root.t-password; font-size: Theme.font-sm; color: Theme.text-secondary; }
                            LineEdit {
                                text: root.editing-cred.color-tag;
                                placeholder-text: "••••";
                                input-type: password;
                                font-size: Theme.font-md;
                                edited => { root.editing-cred.color-tag = self.text; }
                            }
                        }

                        // Language + Environment
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.t-language-field; font-size: Theme.font-sm; color: Theme.text-secondary; }
                                LineEdit {
                                    text: root.editing-cred.language;
                                    font-size: Theme.font-md;
                                    edited => { root.editing-cred.language = self.text; }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 2px;
                                Text { text: root.t-environment; font-size: Theme.font-sm; color: Theme.text-secondary; }
                                LineEdit {
                                    text: root.editing-cred.environment;
                                    font-size: Theme.font-md;
                                    edited => { root.editing-cred.environment = self.text; }
                                }
                            }
                        }

                        // Description
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: root.t-description; font-size: Theme.font-sm; color: Theme.text-secondary; }
                            LineEdit {
                                text: root.editing-cred.description;
                                font-size: Theme.font-md;
                                edited => { root.editing-cred.description = self.text; }
                            }
                        }

                        // SNC
                        HorizontalLayout {
                            spacing: Theme.spacing-md;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: root.t-snc; font-size: Theme.font-sm; color: Theme.text-secondary; }
                                Switch {
                                    checked: root.editing-cred.snc-enabled;
                                    toggled => { root.editing-cred.snc-enabled = self.checked; }
                                }
                            }
                            if root.editing-cred.snc-enabled : VerticalLayout {
                                horizontal-stretch: 1; spacing: 2px;
                                Text { text: root.t-snc-sso; font-size: Theme.font-sm; color: Theme.text-secondary; }
                                Switch {
                                    checked: false;
                                }
                            }
                        }
                    }
                }

                // Footer: Save / Delete
                Rectangle { background: Theme.border; height: 1px; }
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: Theme.spacing-lg; padding-right: Theme.spacing-lg;
                        spacing: Theme.spacing-sm;
                        if root.editing-cred.id != "" : Rectangle {
                            width: 80px;
                            border-radius: Theme.radius-sm;
                            background: del-btn-touch.pressed ? #cc3b30 : Theme.danger;
                            del-btn-touch := TouchArea { clicked => {
                                root.delete-cred-name = root.editing-cred.display-name != "" ? root.editing-cred.display-name : root.editing-cred.connection-id;
                                root.show-delete-confirm = true;
                            } }
                            Text {
                                text: root.t-delete; color: white; font-size: Theme.font-sm; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 80px; border-radius: Theme.radius-sm;
                            background: save-btn-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                            save-btn-touch := TouchArea { clicked => { root.save-cred(); } }
                            Text {
                                text: root.t-cancel; font-size: Theme.font-sm; color: Theme.text-primary;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 80px; border-radius: Theme.radius-sm;
                            background: save-ok-touch.pressed ? Theme.accent-hover : Theme.accent;
                            save-ok-touch := TouchArea { clicked => { root.save-cred(); } }
                            Text {
                                text: root.t-save; color: white; font-size: Theme.font-sm; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== Reveal Password Modal =====
    if root.show-reveal-modal : Rectangle {
        background: Theme.overlay;
        animate background { duration: 200ms; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - 48px;
            height: root.reveal-verified ? 220px : 260px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-primary;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;
                // Header
                HorizontalLayout {
                    Text {
                        text: root.t-reveal-title;
                        font-size: Theme.font-lg; font-weight: 700; color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 14px;
                        background: close-reveal-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                        close-reveal-touch := TouchArea { clicked => { root.close-reveal(); } }
                        Text { text: "✕"; font-size: 14px; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                // Credential name
                Text {
                    text: root.reveal-cred-name;
                    font-size: Theme.font-md; color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
                // Verify input (when not verified)
                if !root.reveal-verified : VerticalLayout {
                    spacing: Theme.spacing-sm;
                    Text {
                        text: root.t-reveal-verify;
                        font-size: Theme.font-sm; color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                    verify-pw := LineEdit {
                        text: ""; font-size: Theme.font-md;
                        input-type: password;
                        placeholder-text: root.t-password;
                    }
                    Rectangle {
                        height: 40px; border-radius: Theme.radius-md;
                        background: verify-btn-touch.pressed ? Theme.accent-hover : Theme.accent;
                        verify-btn-touch := TouchArea { clicked => { root.verify-reveal(verify-pw.text); } }
                        Text {
                            text: root.t-reveal-verify-btn; color: white;
                            font-size: Theme.font-md; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                }
                // Password display (when verified)
                if root.reveal-verified : VerticalLayout {
                    spacing: Theme.spacing-sm;
                    Text {
                        text: root.t-reveal-password-label;
                        font-size: Theme.font-sm; color: Theme.text-muted;
                    }
                    Rectangle {
                        height: 40px; background: Theme.bg-secondary; border-radius: Theme.radius-sm;
                        HorizontalLayout {
                            padding-left: 12px; padding-right: 8px;
                            Text {
                                text: root.revealed-password;
                                font-size: Theme.font-md; color: Theme.text-primary;
                                vertical-alignment: center; horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Rectangle {
                                width: 40px;
                                background: copy-reveal-touch.pressed ? Theme.bg-hover : Theme.bg-input;
                                border-radius: Theme.radius-sm;
                                copy-reveal-touch := TouchArea { clicked => { root.copy-password(root.reveal-cred-id); } }
                                Text { text: root.t-reveal-copy; font-size: Theme.font-sm; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    Text {
                        text: root.t-reveal-auto-hide;
                        font-size: Theme.font-sm; color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    // ===== Delete Confirmation Modal =====
    if root.show-delete-confirm : Rectangle {
        background: Theme.overlay;
        animate background { duration: 200ms; }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - 64px;
            height: 240px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-primary;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-md;
                alignment: center;
                // Red trash icon
                Rectangle {
                    width: 56px; height: 56px; border-radius: 28px;
                    background: #ffeaea;
                    Text {
                        text: "🗑"; font-size: 24px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Text {
                    text: root.t-confirm-delete;
                    font-size: Theme.font-lg; font-weight: 700; color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.delete-cred-name;
                    font-size: Theme.font-md; color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.t-delete-warning;
                    font-size: Theme.font-sm; color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    alignment: center;
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: del-cancel-touch.pressed ? Theme.bg-hover : Theme.bg-secondary;
                        del-cancel-touch := TouchArea { clicked => { root.close-delete(); } }
                        Text { text: root.t-cancel; font-size: Theme.font-md; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: del-ok-touch.pressed ? #cc3b30 : Theme.danger;
                        del-ok-touch := TouchArea { clicked => { root.confirm-delete(); } }
                        Text { text: root.t-delete; color: white; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // ===== Create Group Modal =====
    if root.show-create-group : Rectangle {
        background: Theme.overlay;
        animate background { duration: 200ms; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.close-create-group(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - 64px;
            height: 200px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-primary;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-lg;
                Text {
                    text: root.t-group-create;
                    font-size: Theme.font-lg; font-weight: 700; color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                new-grp-input := LineEdit {
                    placeholder-text: root.t-group-name-prompt;
                    horizontal-stretch: 1;
                }
                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    alignment: center;
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: cg-cancel.pressed ? Theme.bg-hover : Theme.bg-secondary;
                        cg-cancel := TouchArea { clicked => { root.close-create-group(); } }
                        Text { text: root.t-cancel; font-size: Theme.font-md; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: cg-ok.pressed ? Theme.accent-hover : Theme.accent;
                        cg-ok := TouchArea { clicked => { root.create-group(new-grp-input.text); } }
                        Text { text: root.t-save; color: white; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // ===== Rename Group Modal =====
    if root.show-rename-group : Rectangle {
        background: Theme.overlay;
        animate background { duration: 200ms; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.close-rename-group(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - 64px;
            height: 200px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-primary;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-lg;
                Text {
                    text: root.t-group-rename;
                    font-size: Theme.font-lg; font-weight: 700; color: Theme.text-primary;
                    horizontal-alignment: center;
                }
                rn-grp-input := LineEdit {
                    text: root.rename-group-name;
                    placeholder-text: root.t-group-name-prompt;
                    horizontal-stretch: 1;
                }
                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    alignment: center;
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: rn-cancel.pressed ? Theme.bg-hover : Theme.bg-secondary;
                        rn-cancel := TouchArea { clicked => { root.close-rename-group(); } }
                        Text { text: root.t-cancel; font-size: Theme.font-md; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: rn-ok.pressed ? Theme.accent-hover : Theme.accent;
                        rn-ok := TouchArea { clicked => { root.rename-group(root.rename-group-id, rn-grp-input.text); } }
                        Text { text: root.t-save; color: white; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // ===== Delete Group Modal =====
    if root.show-delete-group : Rectangle {
        background: Theme.overlay;
        animate background { duration: 200ms; }
        TouchArea { width: parent.width; height: parent.height; clicked => { root.close-delete-group(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - 48px;
            height: 280px;
            border-radius: Theme.radius-lg;
            background: Theme.bg-primary;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 10px;
            VerticalLayout {
                padding: Theme.spacing-xl;
                spacing: Theme.spacing-md;
                Text {
                    text: root.t-group-delete;
                    font-size: Theme.font-lg; font-weight: 700; color: Theme.danger;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.delete-group-name;
                    font-size: Theme.font-md; color: Theme.text-secondary;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.delete-group-count + " " + root.t-group-delete-warn;
                    font-size: Theme.font-sm; color: Theme.text-muted;
                    horizontal-alignment: center;
                }
                Rectangle { height: 8px; }
                // Move to default option
                Rectangle {
                    height: 40px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: 8px;
                        Rectangle {
                            width: 18px; height: 18px; border-radius: 9px;
                            border-width: 2px; border-color: Theme.accent;
                            background: root.delete-group-mode == "move" ? Theme.accent : transparent;
                            TouchArea { clicked => { root.delete-group-mode = "move"; } }
                        }
                        Text {
                            text: root.t-group-delete-move;
                            font-size: Theme.font-md; color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
                // Delete all option
                Rectangle {
                    height: 40px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-sm;
                    HorizontalLayout {
                        padding-left: Theme.spacing-md;
                        padding-right: Theme.spacing-md;
                        spacing: 8px;
                        Rectangle {
                            width: 18px; height: 18px; border-radius: 9px;
                            border-width: 2px; border-color: Theme.danger;
                            background: root.delete-group-mode == "delete" ? Theme.danger : transparent;
                            TouchArea { clicked => { root.delete-group-mode = "delete"; } }
                        }
                        Text {
                            text: root.t-group-delete-all;
                            font-size: Theme.font-md; color: Theme.danger;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    alignment: center;
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: dg-cancel.pressed ? Theme.bg-hover : Theme.bg-secondary;
                        dg-cancel := TouchArea { clicked => { root.close-delete-group(); } }
                        Text { text: root.t-cancel; font-size: Theme.font-md; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 100px; height: 40px; border-radius: Theme.radius-md;
                        background: dg-ok.pressed ? #cc3b30 : Theme.danger;
                        dg-ok := TouchArea { clicked => { root.delete-group(root.delete-group-id, root.delete-group-mode); } }
                        Text { text: root.t-delete; color: white; font-size: Theme.font-md; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}

// ===== Main App =====
export component App inherits Window {
    title: "SAP Login Manager";
    preferred-width: 440px;
    preferred-height: 956px;
    min-width: 360px;
    min-height: 600px;
    background: Theme.bg-primary;

    // App state: 0=setup, 1=unlock, 2=main, 3=settings
    in-out property <int> page-state: 1;
    in-out property <string> search-text: "";
    in-out property <string> active-group: "all";
    in-out property <bool> batch-mode: false;
    in-out property <bool> show-credential-form: false;
    in-out property <bool> show-reveal-modal: false;
    in-out property <bool> show-delete-confirm: false;
    in-out property <bool> show-toast: false;
    in-out property <string> toast-message: "";
    in-out property <string> unlock-error: "";
    in-out property <bool> show-more-menu: false;

    in-out property <[CredentialItem]> credentials: [];
    in-out property <[GroupItem]> groups: [];
    in-out property <int> all-count: 0;
    in-out property <int> favorites-count: 0;
    in-out property <[CredentialItem]> selected-creds: [];
    in-out property <CredentialItem> editing-cred: {
        id: "", connection-id: "", display-name: "", client: "", username: "",
        language: "ZH", system-id: "", environment: "", color-tag: "",
        is-favorite: false, login-count: 0, group-id: "", snc-enabled: false,
        description: "",
        is-selected: false,
    };
    in-out property <string> reveal-cred-id: "";
    in-out property <string> reveal-cred-name: "";
    in-out property <string> revealed-password: "";
    in-out property <bool> reveal-verified: false;
    in-out property <string> delete-cred-name: "";

    // Filtered credentials (computed by Rust from credentials + active-group + search-text)
    in-out property <[CredentialItem]> filtered-credentials: [];

    // Group management state
    in-out property <bool> show-group-dropdown: false;
    in-out property <bool> show-batch-move-dropdown: false;
    in-out property <bool> show-create-group: false;
    in-out property <bool> show-rename-group: false;
    in-out property <bool> show-delete-group: false;
    in-out property <string> rename-group-id: "";
    in-out property <string> rename-group-name: "";
    in-out property <string> delete-group-id: "";
    in-out property <string> delete-group-name: "";
    in-out property <string> delete-group-mode: "move";
    in-out property <int> delete-group-count: 0;
    in-out property <string> current-group-name: "全部";
    in-out property <int> current-group-count: 0;

    // Settings
    in-out property <bool> settings-password-free: false;
    in-out property <int> settings-batch-interval: 2;
    in-out property <int> settings-auto-lock: 3;
    in-out property <int> settings-clipboard-clear: 20;
    in-out property <bool> settings-group-by-env: true;
    in-out property <bool> settings-compact: false;
    in-out property <string> settings-language: "ZH";
    in-out property <string> settings-theme: "light";
    in-out property <string> settings-sap-logon-path: "";

    // i18n strings
    in-out property <string> t-title: "SAP Login Manager";
    in-out property <string> t-unlock-prompt: "请输入主密码解锁";
    in-out property <string> t-unlock-btn: "解锁";
    in-out property <string> t-setup-prompt: "设置主密码";
    in-out property <string> t-setup-confirm: "确认设置";
    in-out property <string> t-password-free-hint: "本次启动内免输入主密码";
    in-out property <string> t-search-placeholder: "搜索连接...";
    in-out property <string> t-add: "新建凭据";
    in-out property <string> t-login: "登录";
    in-out property <string> t-batch-login: "批量登录";
    in-out property <string> t-copy-password: "复制密码";
    in-out property <string> t-reveal-password: "查看密码";
    in-out property <string> t-edit: "编辑";
    in-out property <string> t-delete: "删除";
    in-out property <string> t-favorite: "收藏";
    in-out property <string> t-cancel-favorite: "取消收藏";
    in-out property <string> t-share: "分享连接";
    in-out property <string> t-settings: "设置";
    in-out property <string> t-save: "保存";
    in-out property <string> t-cancel: "取消";
    in-out property <string> t-confirm-delete: "确认删除";
    in-out property <string> t-delete-warning: "删除后不可恢复";
    in-out property <string> t-group-all: "全部";
    in-out property <string> t-group-favorites: "收藏";
    in-out property <string> t-lock: "锁定";
    in-out property <string> t-sap-logon: "SAP Logon";
    in-out property <string> t-import: "导入连接";
    in-out property <string> t-export: "导出";
    in-out property <string> t-theme-light: "浅色";
    in-out property <string> t-theme-dark: "深色";
    in-out property <string> t-password-free: "免密模式";
    in-out property <string> t-batch-interval: "批量登录间隔(秒)";
    in-out property <string> t-auto-lock: "自动锁定(分钟)";
    in-out property <string> t-clipboard-clear: "剪贴板自动清空(秒)";
    in-out property <string> t-group-by-env: "按环境分组";
    in-out property <string> t-compact-mode: "紧凑模式";
    in-out property <string> t-language: "语言";
    in-out property <string> t-reveal-title: "查看密码";
    in-out property <string> t-reveal-verify: "请输入解锁密码验证身份";
    in-out property <string> t-reveal-verify-btn: "验证";
    in-out property <string> t-reveal-password-label: "密码";
    in-out property <string> t-reveal-copy: "复制";
    in-out property <string> t-reveal-auto-hide: "20秒后自动关闭";
    in-out property <string> t-connection-name: "连接名称";
    in-out property <string> t-client: "客户端";
    in-out property <string> t-username: "用户名";
    in-out property <string> t-password: "密码";
    in-out property <string> t-language-field: "语言";
    in-out property <string> t-system-id: "系统标识";
    in-out property <string> t-environment: "环境";
    in-out property <string> t-description: "描述";
    in-out property <string> t-snc: "SNC";
    in-out property <string> t-snc-sso: "SNC SSO";
    in-out property <string> t-empty-list: "暂无凭据，点击右下角按钮新建";
    in-out property <string> t-no-creds-selected: "未选中任何凭据";
    in-out property <string> t-group-manage: "管理分组";
    in-out property <string> t-group-create: "新建分组";
    in-out property <string> t-group-rename: "重命名";
    in-out property <string> t-group-delete: "删除分组";
    in-out property <string> t-group-delete-warn: "删除后不可恢复";
    in-out property <string> t-group-delete-move: "移入默认分组";
    in-out property <string> t-group-delete-all: "连同凭据一起删除";
    in-out property <string> t-group-section-system: "系统分组";
    in-out property <string> t-group-section-custom: "自定义分组";
    in-out property <string> t-group-name-prompt: "分组名称";
    in-out property <string> t-group-empty: "暂无自定义分组";
    in-out property <string> t-batch-move: "移动到分组";
    in-out property <string> t-batch-select: "批量选择";
    in-out property <string> t-batch-cancel: "退出批量";
    in-out property <string> t-batch-selected: "已选";

    // Callbacks
    callback unlock(string);
    callback setup(string);
    callback change-password(string, string);
    callback login(string);
    callback batch-login();
    callback copy-password(string);
    callback reveal-password(string);
    callback verify-reveal(string);
    callback edit-credential(string);
    callback save-credential();
    callback delete-credential(string);
    callback restore-credential(CredentialItem);
    callback toggle-favorite(string);
    callback share-credential(string);
    callback open-sap-logon();
    callback import-sap-connections();
    callback export-credentials();
    callback save-settings();
    callback lock();
    callback select-credential(string, bool);
    callback batch-move-to-group(string);
    callback batch-favorite(bool);
    callback enter_batch();
    callback apply-theme(string);
    callback apply-language(string);
    callback search_changed(string);
    callback group_changed(string);
    callback create_group(string);
    callback rename_group(string, string);
    callback delete_group(string, string);

    // ===== Layout =====
    if page-state <= 1 : UnlockPage {
        width: 100%;
        height: 100%;
        is-setup: root.page-state == 0;
        prompt: root.page-state == 0 ? root.t-setup-prompt : root.t-unlock-prompt;
        button-text: root.page-state == 0 ? root.t-setup-confirm : root.t-unlock-btn;
        hint: root.t-password-free-hint;
        error-message: root.unlock-error;
        submitted(pw) => {
            if root.page-state == 0 { root.setup(pw); }
            else { root.unlock(pw); }
        }
    }

    if page-state == 2 : MainPage {
        width: 100%;
        height: 100%;
        credentials: root.credentials;
        groups: root.groups;
        search-text: root.search-text;
        active-group: root.active-group;
        all-count: root.all-count;
        favorites-count: root.favorites-count;
        batch-mode: root.batch-mode;
        selected-creds: root.selected-creds;
        show-credential-form: root.show-credential-form;
        show-reveal-modal: root.show-reveal-modal;
        show-delete-confirm: root.show-delete-confirm;
        editing-cred: root.editing-cred;
        reveal-cred-id: root.reveal-cred-id;
        reveal-cred-name: root.reveal-cred-name;
        revealed-password: root.revealed-password;
        reveal-verified: root.reveal-verified;
        delete-cred-name: root.delete-cred-name;
        show-toast: root.show-toast;
        toast-message: root.toast-message;
        show-more-menu: root.show-more-menu;

        // Filtered credentials + group management
        filtered-credentials: root.filtered-credentials;
        show-group-dropdown: root.show-group-dropdown;
        show-batch-move-dropdown: root.show-batch-move-dropdown;
        show-create-group: root.show-create-group;
        show-rename-group: root.show-rename-group;
        show-delete-group: root.show-delete-group;
        rename-group-id: root.rename-group-id;
        rename-group-name: root.rename-group-name;
        delete-group-id: root.delete-group-id;
        delete-group-name: root.delete-group-name;
        delete-group-mode: root.delete-group-mode;
        delete-group-count: root.delete-group-count;
        current-group-name: root.current-group-name;
        current-group-count: root.current-group-count;

        t-title: root.t-title;
        t-search-placeholder: root.t-search-placeholder;
        t-add: root.t-add;
        t-login: root.t-login;
        t-batch-login: root.t-batch-login;
        t-copy-password: root.t-copy-password;
        t-reveal-password: root.t-reveal-password;
        t-edit: root.t-edit;
        t-delete: root.t-delete;
        t-favorite: root.t-favorite;
        t-cancel-favorite: root.t-cancel-favorite;
        t-share: root.t-share;
        t-settings: root.t-settings;
        t-save: root.t-save;
        t-cancel: root.t-cancel;
        t-confirm-delete: root.t-confirm-delete;
        t-delete-warning: root.t-delete-warning;
        t-group-all: root.t-group-all;
        t-group-favorites: root.t-group-favorites;
        t-lock: root.t-lock;
        t-sap-logon: root.t-sap-logon;
        t-import: root.t-import;
        t-export: root.t-export;
        t-reveal-title: root.t-reveal-title;
        t-reveal-verify: root.t-reveal-verify;
        t-reveal-verify-btn: root.t-reveal-verify-btn;
        t-reveal-password-label: root.t-reveal-password-label;
        t-reveal-copy: root.t-reveal-copy;
        t-reveal-auto-hide: root.t-reveal-auto-hide;
        t-connection-name: root.t-connection-name;
        t-client: root.t-client;
        t-username: root.t-username;
        t-password: root.t-password;
        t-language-field: root.t-language-field;
        t-system-id: root.t-system-id;
        t-environment: root.t-environment;
        t-description: root.t-description;
        t-snc: root.t-snc;
        t-snc-sso: root.t-snc-sso;
        t-empty-list: root.t-empty-list;
        t-no-creds-selected: root.t-no-creds-selected;
        t-group-manage: root.t-group-manage;
        t-group-create: root.t-group-create;
        t-group-rename: root.t-group-rename;
        t-group-delete: root.t-group-delete;
        t-group-delete-warn: root.t-group-delete-warn;
        t-group-delete-move: root.t-group-delete-move;
        t-group-delete-all: root.t-group-delete-all;
        t-group-section-system: root.t-group-section-system;
        t-group-section-custom: root.t-group-section-custom;
        t-group-name-prompt: root.t-group-name-prompt;
        t-group-empty: root.t-group-empty;
        t-batch-move: root.t-batch-move;
        t-batch-select: root.t-batch-select;
        t-batch-cancel: root.t-batch-cancel;
        t-batch-selected: root.t-batch-selected;

        search-changed(text) => { root.search-text = text; root.search_changed(text); }
        group-changed(gid) => { root.active-group = gid; root.group_changed(gid); }
        login(id) => { root.login(id); }
        batch-login() => { root.batch-login(); }
        copy-password(id) => { root.copy-password(id); }
        reveal-password(id) => { root.reveal-password(id); }
        edit(id) => { root.edit-credential(id); }
        save-cred() => { root.save-credential(); }
        delete(id) => { root.delete-credential(id); }
        toggle-favorite(id) => { root.toggle-favorite(id); }
        share(id) => { root.share-credential(id); }
        open-sap-logon() => { root.open-sap-logon(); }
        import-connections() => { root.import-sap-connections(); }
        export-creds() => { root.export-credentials(); }
        lock() => { root.lock(); }
        select(id, checked) => { root.select-credential(id, checked); }
        batch-move(gid) => { root.batch-move-to-group(gid); }
        batch-fav(fav) => { root.batch-favorite(fav); }
        show-settings() => { root.page-state = 3; }
        add-new() => {
            root.editing-cred = {
                id: "", connection-id: "", display-name: "", client: "", username: "",
                language: "ZH", system-id: "", environment: "", color-tag: "",
                is-favorite: false, login-count: 0, group-id: "", snc-enabled: false,
                description: "",
            };
            root.show-credential-form = true;
        }
        verify-reveal(pw) => { root.verify-reveal(pw); }
        close-reveal() => {
            root.show-reveal-modal = false;
            root.revealed-password = "";
            root.reveal-verified = false;
        }
        close-form() => { root.show-credential-form = false; }
        close-delete() => { root.show-delete-confirm = false; }
        confirm-delete() => {
            if root.editing-cred.id != "" { root.delete-credential(root.editing-cred.id); }
            root.show-delete-confirm = false;
        }
        cancel-batch() => { root.batch-mode = false; root.selected-creds = []; root.show-batch-move-dropdown = false; }
        toggle-more-menu() => { root.show-more-menu = !root.show-more-menu; }
        enter-batch() => { root.show-more-menu = false; root.batch-mode = true; }
        sap-logon() => { root.show-more-menu = false; root.open-sap-logon(); }
        import-conn() => { root.show-more-menu = false; root.import-sap-connections(); }
        export-conn() => { root.show-more-menu = false; root.export-credentials(); }
        toggle-group-dropdown() => { root.show-group-dropdown = !root.show-group-dropdown; }
        close-group-dropdown() => { root.show-group-dropdown = false; }
        close-create-group() => { root.show-create-group = false; }
        close-rename-group() => { root.show-rename-group = false; }
        close-delete-group() => { root.show-delete-group = false; }
        create-group(name) => { root.create_group(name); }
        rename-group(id, name) => { root.rename_group(id, name); }
        delete-group(id, mode) => { root.delete_group(id, mode); }
        start-rename-group(id, name) => {
            root.rename-group-id = id;
            root.rename-group-name = name;
            root.show-rename-group = true;
        }
        start-delete-group(id, name, count) => {
            root.delete-group-id = id;
            root.delete-group-name = name;
            root.delete-group-count = count;
            root.delete-group-mode = "move";
            root.show-delete-group = true;
        }
    }

    if page-state == 3 : SettingsPage {
        width: 100%;
        height: 100%;
        password-free: root.settings-password-free;
        batch-interval: root.settings-batch-interval;
        auto-lock: root.settings-auto-lock;
        clipboard-clear: root.settings-clipboard-clear;
        group-by-env: root.settings-group-by-env;
        compact: root.settings-compact;
        language: root.settings-language;
        theme: root.settings-theme;
        sap-logon-path: root.settings-sap-logon-path;

        t-save: root.t-save;
        t-cancel: root.t-cancel;
        t-password-free: root.t-password-free;
        t-password-free-hint: root.t-password-free-hint;
        t-batch-interval: root.t-batch-interval;
        t-auto-lock: root.t-auto-lock;
        t-clipboard-clear: root.t-clipboard-clear;
        t-group-by-env: root.t-group-by-env;
        t-compact-mode: root.t-compact-mode;
        t-language: root.t-language;
        t-theme-light: root.t-theme-light;
        t-theme-dark: root.t-theme-dark;
        t-sap-logon: root.t-sap-logon;

        save(pf, bi, al, cc, gbe, comp, lang, theme, path) => {
            root.settings-password-free = pf;
            root.settings-batch-interval = bi;
            root.settings-auto-lock = al;
            root.settings-clipboard-clear = cc;
            root.settings-group-by-env = gbe;
            root.settings-compact = comp;
            root.settings-language = lang;
            root.settings-theme = theme;
            root.settings-sap-logon-path = path;
            root.save-settings();
            root.apply-theme(theme);
            root.apply-language(lang);
            root.page-state = 2;
        }
        cancel() => { root.page-state = 2; }
    }
}
